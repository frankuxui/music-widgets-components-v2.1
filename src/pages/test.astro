---
import Expo from "@/layouts/Expo.astro";
---

<Expo>
  <section class="columns-2 gap-3 mb-3 break-inside">
    <article class="w-full border break-inside flex items-start flex-col justify-between rounded-xl gap-2 p-4 mb-3 text-xs bg-background border-border">
      <header class="w-full flex items-center justify-between">
        <button class="flex justify-center items-center rounded-full w-8 h-8 transition-colors duration-300">
          <span class="icon-fill">play_arrow</span>
        </button>
        <button class="w-8 h-8 rounded-full inline-flex flex-none items-center justify-center transition-all duration-300 hover:bg-foreground/10 focus:ring-2 focus:ring-blue-500">
          <span class="icon-rounded">more_horiz</span>
        </button>
      </header>
      <section class="w-full mt-1 grid gap-1">
        <h2 class="text-xs">Bed time</h2>
        <h3 class="text-sm leading-5 font-semibold">Good Together Filatov</h3>
      </section>
      <div class="flex items-center gap-3">
        <img class="flex-none w-8 h-8 rounded-full object-cover" src="https://randomuser.me/api/portraits/women/68.jpg" alt="cover" loading="lazy" />
        <div class="grid">
          <h5 class="truncate text-xs font-semibold">Sunshine sound</h5>
          <p class="text-xs truncate text-foreground/50">Lookee Stefane</p>
        </div>
      </div>
    </article>
    <article class="w-full border break-inside flex items-start flex-col justify-between rounded-xl gap-2 p-4 mb-3 text-xs bg-background border-border">
      <div class="grid grid-cols-2">
        <div>
          <span class="icon-rounded icon-xs">more_horiz</span>
          <span class="icon-rounded icon-sm">more_horiz</span>
          <span class="icon-rounded icon-md">more_horiz</span>
          <span class="icon-rounded icon-lg">more_horiz</span>
          <span class="icon-rounded icon-xl">more_horiz</span>
          <span class="icon-rounded icon-2xl">more_horiz</span>
        </div>
        <div>
          <span class="icon-fill icon-xs">play_arrow</span>
          <span class="icon-fill icon-sm">play_arrow</span>
          <span class="icon-fill icon-md">play_arrow</span>
          <span class="icon-fill icon-lg">play_arrow</span>
          <span class="icon-fill icon-xl">play_arrow</span>
          <span class="icon-fill icon-2xl">play_arrow</span>
        </div>
      </div>
    </article>
  </section>
</Expo>

<style>
  .icon-rounded {
    font-family: "Material Symbols Rounded" !important;
    display: inline-block;
    line-height: 1;
    text-transform: none;
    letter-spacing: normal;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    font-size: 28px;
    font-variation-settings:
      "FILL" 0,
      "wght" 400,
      "GRAD" 0,
      "opsz" 24;
  }
  .icon-fill {
    font-family: "Material Symbols Rounded" !important;
    display: inline-block;
    line-height: 1;
    text-transform: none;
    letter-spacing: normal;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    font-size: 28px;
    font-variation-settings:
      "FILL" 1,
      "wght" 400,
      "GRAD" 0,
      "opsz" 20;
  }
  .icon-xs {
    font-size: 24px;
  }
  .icon-sm {
    font-size: 28px;
  }
  .icon-md {
    font-size: 32px;
  }
  .icon-lg {
    font-size: 36px;
  }
  .icon-xl {
    font-size: 40px;
  }
  .icon-2xl {
    font-size: 44px;
  }
</style>
